{
  "schema_version": 1,
  "capabilities": [
    {
      "id": "pge.human_start.revision_bound",
      "kind": "human_start_revision_bound",
      "spec_template": "docs/pge/spec.template.md",
      "protocol": {
        "path": "harness/pge-protocol.md",
        "required_lines": [
          "approved_contract_revision == contract_revision",
          "channel != \"\"",
          "evidence != \"\"",
          "Pre-Challenge structure checks do not require Human Start approval.",
          "python3 scripts/check_pge_contracts.py docs/pge/<sprint>-spec.md"
        ]
      },
      "checker": {
        "path": "scripts/check_pge_contracts.py",
        "sha256_allowlist": [
          "741db029699124428abd397757ed47629c3c88373885175966895740c8ea91fe"
        ]
      }
    },
    {
      "id": "pge.diagram.control_flow",
      "kind": "mermaid_control_flow",
      "path": "harness/pge-protocol.md",
      "exclusive_paths": [
        ".agents/skills/pge-workflow/SKILL.md",
        "docs/pge/spec.template.md",
        "docs/pge/eval.template.md"
      ],
      "required_nodes": [
        "Planner",
        "Grill",
        "ContractDraft",
        "GeneratorProbe",
        "EvaluatorChallenge",
        "ContractLock",
        "Generator",
        "Implementation",
        "Evaluator",
        "FinalEvaluation",
        "HumanStart",
        "ParallelJoin",
        "Fallback",
        "CircuitBreaker"
      ],
      "required_edges": [
        "Planner --> Grill",
        "Grill --> ContractDraft",
        "ContractDraft --> GeneratorProbe",
        "ContractDraft --> EvaluatorChallenge",
        "GeneratorProbe --> ContractLock",
        "EvaluatorChallenge --> ContractLock",
        "ContractLock --> HumanStart",
        "HumanStart --> Generator",
        "Generator --> Implementation",
        "Generator --> ParallelJoin",
        "Implementation --> ParallelJoin",
        "ParallelJoin --> Evaluator",
        "Evaluator --> FinalEvaluation",
        "Evaluator -->|FAIL| Generator",
        "Evaluator -->|FAIL| Planner",
        "ThirdFailure --> CircuitBreaker",
        "AgentUnavailable --> Fallback"
      ]
    },
    {
      "id": "agent.model.inherit",
      "kind": "toml_absent_top_level_key",
      "paths": [
        ".codex/agents/pge-generator.toml",
        ".codex/agents/pge-evaluator.toml"
      ],
      "key": "model"
    },
    {
      "id": "grill.toolchain.complete",
      "kind": "skill_toolchain",
      "paths": [
        ".agents/skills/grilling/SKILL.md",
        ".agents/skills/domain-modeling/SKILL.md",
        ".agents/skills/grill-me/SKILL.md",
        ".agents/skills/grill-with-docs/SKILL.md"
      ]
    },
    {
      "id": "harness.skill_references.resolve",
      "kind": "skill_references",
      "paths": [
        "AGENTS.md",
        "harness",
        "docs/pge/spec.template.md",
        "docs/pge/eval.template.md",
        ".agents/skills/pge-workflow/SKILL.md"
      ],
      "skill_root": ".agents/skills"
    },
    {
      "id": "project.rules.fact_generated",
      "kind": "fact_generated_documents",
      "paths": [
        "harness/api-standards.md",
        "harness/coding-style.md",
